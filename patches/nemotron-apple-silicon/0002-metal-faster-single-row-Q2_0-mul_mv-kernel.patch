     return qb_curr->d * (2.0f * acc - sumy);
 }
 
-// Q2_0 (Fractal-64) dot: 16-weight group g = il / 16 across two 8-weight sub-blocks (2*g, 2*g + 1)
-inline float block_q_n_dot_y(device const block_q2_0 * qb_curr, float sumy, thread float * yl, int il) {
-    (void)sumy;
-    const int   g        = il >> 4;
-    const int   shift_lo = 2 * g;
-    const int   s_idx    = (g & 1) * 2;
-    const int   s_shift  = (g >> 1) * 4;
-    const float m_lo     = (float)(4u + ((uint(qb_curr->scales[s_idx + 0]) >> s_shift) & 0x0Fu));
-    const float m_hi     = (float)(4u + ((uint(qb_curr->scales[s_idx + 1]) >> s_shift) & 0x0Fu));
+// Q2_0 decode-path dot: 4 threads cooperate on one 64-weight block (thread t handles k = 4t..4t+3 of every group g,
+// i.e. weights 16*g + 4*t + c, loaded as 16-bit words). Each qs byte is loaded by exactly one thread; each qh byte is
+// read by two threads (t and t+2, which use different bits of it); every thread loads the 4 scale bytes and uses two.
+// The codebook {-14,-8,-4,-1,1,4,8,14} is only evaluated (from two packed 32-bit constants, signed bit-field extract)
+// to fill a threadgroup pair table at kernel start; the dot then looks up two weights per threadgroup-memory read.
+inline float q2_0_cb(uint idx) {
+    const uint w = (idx & 4) ? 0x0E080401u : 0xFFFCF8F2u;
+    return (float) extract_bits((int) w, (idx & 3) * 8, 8);
+}
 
-    float acc_lo = 0.0f;
-    float acc_hi = 0.0f;
+inline float q2_0_dot_thread(device const block_q2_0 * qb, thread const float4 * y4, threadgroup const float2 * lut2, short t) {
+    // 32-bit words are assembled from 2-byte-aligned packed_ushort2 loads (blocks are only 2-byte aligned)
+    const packed_ushort2 qv = *(device const packed_ushort2 *)(qb->qs + 4*t);
+    const packed_ushort2 hv = *(device const packed_ushort2 *)(qb->qh + ((4*t) & 7));
+    const packed_ushort2 sv = *(device const packed_ushort2 *)(qb->scales);
 
-    FOR_UNROLL (int k = 0; k < 8; ++k) {
-        const uint qh_b  = qb_curr->qh[k];
-        const uint lo2_0 = (uint(qb_curr->qs[k]) >> shift_lo) & 0x03u;
-        const uint hi1_0 = (qh_b >> shift_lo) & 0x01u;
-        acc_lo += yl[k] * fractal3_val(lo2_0, hi1_0);
+    const uint Q = (uint) qv[0] | ((uint) qv[1] << 16);
+    const uint H = (uint) hv[0] | ((uint) hv[1] << 16);
+    const uint S = (uint) sv[0] | ((uint) sv[1] << 16);
 
-        const uint lo2_1 = (uint(qb_curr->qs[k + 8]) >> shift_lo) & 0x03u;
-        const uint hi1_1 = (qh_b >> (shift_lo + 1)) & 0x01u;
-        acc_hi += yl[k + 8] * fractal3_val(lo2_1, hi1_1);
+    const short hb = t >> 1; // k >> 3 for this thread's k range
+    const uint  Hs = H >> hb;
+    const uint  T  = S >> (8*hb);
+
+    // 4 + scale nibble of sub-block 2g+hb (g = 0..3): low nibbles of bytes hb, 2+hb, then their high nibbles
+    const float4 sc = float4(T & 0xF, (T >> 16) & 0xF, (T >> 4) & 0xF, (T >> 20) & 0xF) + 4.0f;
+
+    float4 sg;
+
+    FOR_UNROLL (short g = 0; g < 4; g++) {
+        // per byte (= weight k): 2 low bits | high bit << 2, i.e. the 3-bit codebook index
+        const uint ix = ((Q >> (2*g)) & 0x03030303u) | (((Hs >> (2*g)) << 2) & 0x04040404u);
+        // merge the indices of weights (0,1) and (2,3) into two 6-bit indices into the pair table
+        const uint pi = (ix | (ix >> 5)) & 0x003F003Fu;
+
+        const float2 p01 = lut2[pi & 0xFFFF];
+        const float2 p23 = lut2[pi >> 16];
+
+        sg[g] = y4[g][0]*p01[0] + y4[g][1]*p01[1] + y4[g][2]*p23[0] + y4[g][3]*p23[1];
     }
 
-    return (float)qb_curr->d * (acc_lo * m_lo + acc_hi * m_hi);
+    return (float) qb->d * dot(sc, sg);
 }
 
 // function for calculate inner product between half a q4_0 block and 16 floats (yl), sumy is SUM(yl[i])
@@ -3832,25 +3849,28 @@ void kernel_mul_mv_q2_0_f32_impl(
         ax[row] = (device const block_q2_0 *) ((device char *) src0 + offset0);
     }
 
-    float yl[16];
+    float4 y4[4];
     float sumf[nr0] = {0.f};
 
-    // group 64: 4 sub-blocks of 16 weights per Q2_0 block
+    // pair table: entry i = (cb[i & 7], cb[i >> 3]) for the codebook values of two weights at once
+    threadgroup float2 * lut2 = (threadgroup float2 *) shmem;
+    lut2[tiisg]      = float2(q2_0_cb(tiisg & 7),        q2_0_cb(tiisg >> 3));
+    lut2[tiisg + 32] = float2(q2_0_cb((tiisg + 32) & 7), q2_0_cb((tiisg + 32) >> 3));
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    // 4 threads per 64-weight block, 8 blocks in flight per simdgroup
     const short ix = (tiisg/4);
-    const short il = (tiisg%4)*16;
+    const short it = (tiisg%4);
 
-    device const float * yb = y + ix*QK2_0 + il;
+    device const float * yb = y + ix*QK2_0 + 4*it;
 
     for (int ib = ix; ib < nb; ib += N_SIMDWIDTH/4) {
-        float sumy = 0.f;
-
-        FOR_UNROLL (short i = 0; i < 16; i++) {
-            yl[i] = yb[i];
-            sumy += yb[i];
+        FOR_UNROLL (short g = 0; g < 4; g++) {
+            y4[g] = *((device const float4 *)(yb + 16*g));
         }
 
         FOR_UNROLL (short row = 0; row < nr0; row++) {
-            sumf[row] += block_q_n_dot_y(ax[row] + ib, sumy, yl, il);
+            sumf[row] += q2_0_dot_thread(ax[row] + ib, y4, lut2, it);
         }
 
         yb += QK2_0 * (N_SIMDWIDTH/4);
@@ -3873,10 +3893,11 @@ kernel void kernel_mul_mv_q2_0_f32(
         device const char * src0,
         device const char * src1,
         device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
         uint3  tgpig[[threadgroup_position_in_grid]],
         ushort tiisg[[thread_index_in_simdgroup]],
         ushort sgitg[[simdgroup_index_in_threadgroup]]) {
-    kernel_mul_mv_q2_0_f32_impl<N_R0_Q2_0, constant ggml_metal_kargs_mul_mv &>(args, src0, src1, dst, nullptr, tgpig, tiisg, sgitg);
+    kernel_mul_mv_q2_0_f32_impl<N_R0_Q2_0, constant ggml_metal_kargs_mul_mv &>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg);
 }
 
