+// Q2_0 dot product on random block bytes (random sub-block scales and indices) against a double precision reference
+// computed from the dequantized values. The generic quantizer only produces a narrow range of scale nibbles, so this
+// is what catches a wrong sub-block multiplier or index decode in an arch specific kernel.
+static int test_vec_dot_q2_0_random_blocks(bool verbose) {
+    const auto * q2_0_cpu = ggml_get_type_traits_cpu(GGML_TYPE_Q2_0);
+    const auto * q2_0     = ggml_get_type_traits(GGML_TYPE_Q2_0);
+    const auto * q8_0     = ggml_get_type_traits(GGML_TYPE_Q8_0);
+    assert(q2_0_cpu->vec_dot != nullptr && q2_0_cpu->vec_dot_type == GGML_TYPE_Q8_0);
+
+    constexpr float MAX_ERROR = 1e-5f; // error normalised by sum|w*x|; float rounding is about 1e-7
+    std::mt19937 rng(1234);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+
+    int num_failed = 0;
+    for (int n : {64, 1856, 2688}) {
+        const int nb = n / q2_0->blck_size;
+        std::vector<uint8_t> q2(nb * ggml_type_size(GGML_TYPE_Q2_0));
+        std::vector<uint8_t> q8(n / q8_0->blck_size * ggml_type_size(GGML_TYPE_Q8_0));
+        std::vector<float> act(n), w(n), a(n);
+
+        double worst = 0.0;
+        for (int row = 0; row < 300; row++) {
+            for (size_t i = 0; i < q2.size(); i++) {
+                q2[i] = rng() & 0xFF;
+            }
+            // the first 2 bytes of each block are the fp16 scale: replace them with a sane value
+            for (int b = 0; b < nb; b++) {
+                const ggml_fp16_t d = ggml_fp32_to_fp16(0.001f * (1 + rng() % 100));
+                memcpy(&q2[b * ggml_type_size(GGML_TYPE_Q2_0)], &d, sizeof(d));
+            }
+            for (auto & v : act) {
+                v = nd(rng) * (1 + (row % 5));
+            }
+            q8_0->from_float_ref(act.data(), q8.data(), n);
+            q2_0->to_float(q2.data(), w.data(), n);
+            q8_0->to_float(q8.data(), a.data(), n);
+
+            double ref = 0.0, abs_ref = 0.0;
+            for (int i = 0; i < n; i++) {
+                ref     += (double) w[i] * a[i];
+                abs_ref += fabs((double) w[i] * a[i]);
+            }
+            float result = INFINITY;
+            q2_0_cpu->vec_dot(n, &result, 0, q2.data(), 0, q8.data(), 0, 1);
+            const double err = fabs(result - ref) / abs_ref;
+            if (!(err <= worst)) {
+                worst = err;
+            }
+        }
+
+        const bool failed = !(worst < MAX_ERROR);
+        num_failed += failed;
+        if (failed || verbose) {
+            printf(" q2_0 vec_dot random blocks n=%4d:  %s (max normalised error %g)\n", n, RESULT_STR[failed], worst);
+        }
+    }
+    return num_failed;
+}
+
 int main(int argc, char * argv[]) {
     bool verbose = false;
 
@@ -221,6 +287,7 @@ int main(int argc, char * argv[]) {
 
     num_failed += test_vec_dot_f32(verbose);
