+++ b/tests/test-backend-ops.cpp
@@ -4494,6 +4494,62 @@ struct test_mul_mat_id : public test_case {
     }
 };
 
+// Q2_0 tensors normally get blocks from the quantizer, whose sub-block scale nibbles cover only a narrow range (the
+// largest few values). These variants fill the Q2_0 weights with random raw block bytes (all 16 scale nibbles, all 3-bit
+// indices) and a finite fp16 scale so that every sub-block multiplier and index decode path is checked against the CPU.
+static void init_q2_0_random_blocks(ggml_tensor * t) {
+    GGML_ASSERT(t->type == GGML_TYPE_Q2_0 && ggml_is_contiguous(t));
+    const size_t bs = ggml_type_size(GGML_TYPE_Q2_0);
+    std::vector<uint8_t> data(ggml_nbytes(t));
+    std::default_random_engine gen(1234);
+    std::uniform_int_distribution<int> byte(0, 255);
+    std::uniform_real_distribution<float> scale(0.002f, 0.2f);
+    for (size_t off = 0; off < data.size(); off += bs) {
+        for (size_t i = 0; i < bs; i++) {
+            data[off + i] = (uint8_t) byte(gen);
+        }
+        const ggml_fp16_t d = ggml_fp32_to_fp16(scale(gen));
+        memcpy(&data[off], &d, sizeof(d)); // the first 2 bytes of a block are the fp16 scale
+    }
+    ggml_backend_tensor_set(t, data.data(), 0, data.size());
+}
+
+struct test_mul_mat_q2_0_random_blocks : public test_mul_mat {
+    test_mul_mat_q2_0_random_blocks(int64_t m, int64_t n, int64_t k)
+        : test_mul_mat(GGML_TYPE_Q2_0, GGML_TYPE_F32, m, n, k, {1, 1}, {1, 1}) {}
+
+    std::string vars() override {
+        return test_mul_mat::vars() + ",random_blocks=1";
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_mul_mat::initialize_tensors(ctx);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type == GGML_TYPE_Q2_0) {
+                init_q2_0_random_blocks(t);
+            }
+        }
+    }
+};
+
+struct test_mul_mat_id_q2_0_random_blocks : public test_mul_mat_id {
+    test_mul_mat_id_q2_0_random_blocks(int n_mats, int n_used, int64_t m, int64_t n, int64_t k)
+        : test_mul_mat_id(GGML_TYPE_Q2_0, GGML_TYPE_F32, n_mats, n_used, false, m, n, k) {}
+
+    std::string vars() override {
+        return test_mul_mat_id::vars() + ",random_blocks=1";
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_mul_mat_id::initialize_tensors(ctx);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type == GGML_TYPE_Q2_0) {
+                init_q2_0_random_blocks(t);
+            }
+        }
+    }
+};
+
 // GGML_OP_MUL_MAT_ID + GGML_OP_ADD or GGML_OP_MUL
 struct test_mul_mat_id_fusion : public test_case {
     const ggml_type type_a;
@@ -8888,6 +8944,24 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     }
 #endif
 
+    // Q2_0 (Fractal-64, 30-byte block) at model-realistic dims: odd block counts, multi-row, all mul_mv/mul_mv_ext/mul_mm batch regimes
+    for (int k : {64, 1856, 2688}) {
+        for (int n : {1, 2, 3, 5, 8, 9, 32, 128}) {
+            test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q2_0, GGML_TYPE_F32, 257, n, k, {1, 1}, {1, 1}));
+        }
+        test_cases.emplace_back(new test_mul_mat_id(GGML_TYPE_Q2_0, GGML_TYPE_F32, 8, 2, false, 130, 1,  k));
+        test_cases.emplace_back(new test_mul_mat_id(GGML_TYPE_Q2_0, GGML_TYPE_F32, 8, 2, false, 130, 64, k));
+    }
+
+    // same shapes with random raw Q2_0 block bytes instead of quantizer output
+    for (int k : {64, 1856}) {
+        for (int n : {1, 2, 5, 9, 32}) {
+            test_cases.emplace_back(new test_mul_mat_q2_0_random_blocks(257, n, k));
+        }
+        test_cases.emplace_back(new test_mul_mat_id_q2_0_random_blocks(8, 2, 130, 1,  k));
+        test_cases.emplace_back(new test_mul_mat_id_q2_0_random_blocks(8, 2, 130, 64, k));
+    }
+
 #if 1
     for (ggml_type type_a : base_types) {
         for (ggml_type type_b : {GGML_TYPE_F32, GGML_TYPE_F16}) {
@@ -10121,6 +10195,17 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
         }
     }
 
+    // decode-shaped expert and dense matmuls at Nemotron-3.5-30B-A3B dims (hidden 2688, expert ffn 1856, 128 experts, 6 used),
+    // n = 1 (decode), 2..8 (small batches, speculative decoding) and 512 (prefill)
+    for (ggml_type type_a : {GGML_TYPE_Q2_0, GGML_TYPE_Q4_0}) {
+        test_cases.emplace_back(new test_mul_mat_id(type_a, GGML_TYPE_F32, 128, 6, false, 1856, 1, 2688));
+        test_cases.emplace_back(new test_mul_mat_id(type_a, GGML_TYPE_F32, 128, 6, false, 2688, 1, 1856));
+        for (int n : {1, 2, 3, 4, 5, 8, 512}) {
+            test_cases.emplace_back(new test_mul_mat(type_a, GGML_TYPE_F32, 2688, n, 2688, {1, 1}, {1, 1}));
+        }
+        test_cases.emplace_back(new test_mul_mat(type_a, GGML_TYPE_F32, 8192, 1, 2688, {1, 1}, {1, 1}));
+    }
+
     return test_cases;
 }
 
